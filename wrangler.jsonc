{
  // Jacqueline — static game served from ./public, plus a tiny API for cloud saves.
  "name": "jacqueline",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "kv_namespaces": [
    // Create with:  npx wrangler kv namespace create SAVES   — then paste the id here.
    { "binding": "SAVES", "id": "96491e6befbc482b83fa384c7817f7a3" }
  ]
}
